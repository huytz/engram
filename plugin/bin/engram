#!/bin/sh
# Runs the engram release this plugin pins; downloads and sha256-checks it on first use.
set -eu
VERSION=0.1.5
REPO=huytz/engram
home=${ENGRAM_HOME:-$HOME/.engram}
bin=${ENGRAM_BIN:-$home/bin/engram-$VERSION}

fetch() {
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) t=aarch64-apple-darwin ;;
    Darwin-x86_64) t=x86_64-apple-darwin ;;
    Linux-x86_64) t=x86_64-unknown-linux-gnu ;;
    Linux-aarch64 | Linux-arm64) t=aarch64-unknown-linux-gnu ;;
    *) echo "engram: no release for $(uname -s)-$(uname -m)" >&2; return 1 ;;
  esac
  name=engram-v$VERSION-$t
  url=https://github.com/$REPO/releases/download/v$VERSION/$name.tar.gz
  tmp=$(mktemp -d) || return 1
  ok=0
  # set -e is off inside `if ! fetch`, so chain every step
  curl -fsSL --max-time 60 -o "$tmp/$name.tar.gz" "$url" &&
    curl -fsSL --max-time 20 -o "$tmp/$name.tar.gz.sha256" "$url.sha256" &&
    (cd "$tmp" && if command -v shasum >/dev/null; then shasum -a 256 -c "$name.tar.gz.sha256"; else sha256sum -c "$name.tar.gz.sha256"; fi) >/dev/null &&
    tar -xzf "$tmp/$name.tar.gz" -C "$tmp" &&
    mkdir -p "$home/bin" &&
    cp "$tmp/$name/engram" "$bin.tmp.$$" && chmod 755 "$bin.tmp.$$" && mv "$bin.tmp.$$" "$bin" && ok=1
  rm -rf "$tmp" "$bin.tmp.$$"
  [ "$ok" = 1 ] || { echo "engram: install from $url failed" >&2; return 1; }
}

if [ ! -x "$bin" ]; then
  if ! fetch; then
    # Hooks must never block the agent: skip quietly, the next session retries
    [ "${1:-}" = hook ] && exit 0
    exit 1
  fi
fi
exec "$bin" "$@"
